{
  "name": "@fundgraph/core",
  "version": "0.1.0",
  "description": "Reusable evidence-first dependency funding analysis library for FundGraph",
  "license": "MIT",
  "type": "module",
  "private": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

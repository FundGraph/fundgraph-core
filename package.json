  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/models.test.js"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}

